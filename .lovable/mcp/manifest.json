            "description": {
              "description": "Libellé de l'opération.",
              "type": "string"
            },
            "record_date": {
              "description": "Date de l'opération au format AAAA-MM-JJ (défaut aujourd'hui).",
              "type": "string"
            }
          },
          "required": [
            "project_id",
            "record_type",
            "amount"
          ]
